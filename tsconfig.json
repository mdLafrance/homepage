{
    "compilerOptions": {
        "strictNullChecks": true,
        "forceConsistentCasingInFileNames": true,
        "target": "ES2020",
        "moduleResolution": "bundler",
        "allowSyntheticDefaultImports": true,
        "jsx": "react-jsx",
        "baseUrl": "./src",
        "paths": {
            "@/*": [
                "./*"
            ],
            "@/context/*": [
                "./context/*"
            ],
            "@/errors/*": [
                "./errors/*"
            ],
            "@/lib/*": [
                "./lib/*"
            ],
            "@/api/*": [
                "./api/*"
            ]
        }
    },
    "include": [
        "src/**/*",
        "environment.d.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ],
    "plugins": [
        {
            "name": "@styled/typescript-styled-plugin",
            "tags": [
                "styled",
                "css",
                "sty"
            ]
        }
    ]
}
