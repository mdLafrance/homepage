{
    "compilerOptions": {
        "strictNullChecks": true,
        "forceConsistentCasingInFileNames": true,
        "target": "ES2020",
        "moduleResolution": "bundler",
        "allowSyntheticDefaultImports": true,
        "jsx": "react"
    },
    "include": [
        "apps/frontend/src/**/*",
        "apps/api/src/**/*",
        "packages/common/src/**/*",
        "scripts/**/*",
        "environment.d.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ],
    "plugins": [
        {
            "name": "@styled/typescript-styled-plugin",
            "tags": [
                "styled",
                "css",
                "sty"
            ]
        }
    ]
}
